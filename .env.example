# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TEACHER_PASSWORD / ADMIN_PASSWORD: Secure access key for Teacher & Admin Login portal (default: ASI@2025)
TEACHER_PASSWORD="ASI@2025"
ADMIN_PASSWORD="ASI@2025"

# Telegram Bot Integration for Real-time NEET CBT Result Alerts & Student Broadcasts
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Supabase Production Database & Auth Integration
# Project URL from Supabase dashboard (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=""
# Anon/Public API Key for client requests with Row Level Security (RLS)
VITE_SUPABASE_ANON_KEY=""
